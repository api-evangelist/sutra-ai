  "info": {
    "_postman_id": "8b251651-05f6-4673-8039-9c5b1b6ab2b5",
    "name": "SUTRA Chat API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OpenAI-compatible REST API for the SUTRA family of multilingual large language models from Two AI (Numeric). The SUTRA-V2 model handles instruction-following and conversational tasks across 50+ languages, and the SUTRA-R0 model provides advanced multi-step reasoning. The same chat/completions endpoint serves both models. The documented base URL is https://api.numeric.tech/v2 and is also reachable as https://api.two.ai/v2; the OpenAI SDK can be pointed at this base_url directly.\n\nContact Support:\n Name: Two AI (Numeric)",
      "type": "text/plain"
    }
  }
